{
  "expo": {
    "name": "SamePace",
    "slug": "samepace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samepace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.samepace",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SamePace uses your location to show sessions near you and how far each one is, and to check you are within 150 m of the meeting point during a live session. Your coordinates stay on your phone.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:samepace.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050506",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.samepace",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "samepace.app",
              "pathPrefix": "/invite/"
            },
            {
              "scheme": "https",
              "host": "samepace.app",
              "pathPrefix": "/session/"
            },
            {
              "scheme": "https",
              "host": "samepace.app",
              "pathPrefix": "/training-block/"
            },
            {
              "scheme": "https",
              "host": "samepace.app",
              "path": "/verified"
            },
            {
              "scheme": "https",
              "host": "samepace.app",
              "path": "/billing-return"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#050506",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SamePace uses your location to show sessions near you and how far each one is, and to check you are within 150 m of the meeting point during a live session. Your coordinates stay on your phone."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#30D158",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.samepace.widgets",
          "groupIdentifier": "group.app.samepace",
          "widgets": [
            {
              "name": "NextSession",
              "displayName": "Next session",
              "description": "Your next SamePace session: what, when and where.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "servesys-corporation",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dbfcec9-77d6-4e78-8d3d-871c2ddcebc5"
      }
    }
  }
}
